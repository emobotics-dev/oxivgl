@@ -438,6 +470,76 @@
  *   STATIC FUNCTIONS
  **********************/
 
+/* `inner_alloc` stays false so that an `lv_array_*` call reaching one of these
+ * arrays -- a path added by a future LVGL, or one missed here -- cannot free or
+ * reallocate an event-allocator buffer through `lv_free`/`lv_realloc`. It
+ * degrades to a leak instead of a cross-allocator free. */
+static void event_array_init(lv_array_t * array, uint32_t capacity, uint32_t element_size)
+{
+    array->size = 0;
+    array->capacity = capacity;
+    array->element_size = element_size;
+    array->inner_alloc = false;
+    array->data = oxivgl_event_malloc((size_t)capacity * element_size);
+    LV_ASSERT_MALLOC(array->data);
+    if(array->data == NULL) array->capacity = 0;
+}
+
+static bool event_array_resize(lv_array_t * array, uint32_t new_capacity)
+{
+    /* Upstream's zero case lands on `&zero_mem` rather than NULL, so it can
+     * never leave a dangling pointer; without this the realloc below would free
+     * the block and the NULL return would leave `array->data` pointing at it.
+     * The array is emptied instead of parked on a sentinel -- the same state the
+     * `kept_count == 0` path produces -- and `lv_event_add` re-initialises it on
+     * the next add, guarded by its `event_array_size(list) == 0` check, so the
+     * NULL is never dereferenced. */
+    if(new_capacity == 0) {
+        event_array_deinit(array);
+        return true;
+    }
+
+    uint8_t * data = oxivgl_event_realloc(array->data, (size_t)new_capacity * array->element_size);
+    LV_ASSERT_MALLOC(data);
+    if(data == NULL) return false;
+
+    array->data = data;
+    array->capacity = new_capacity;
+    if(array->size > new_capacity) array->size = new_capacity;
+    return true;
+}
+
+static lv_result_t event_array_push_back(lv_array_t * array, const void * element)
+{
+    LV_ASSERT_NULL(array->data);
+
+    if(array->size == array->capacity) {
+        /* Same linear growth as `lv_array_push_back`; the point of routing is
+         * WHERE the memory comes from, not how often it grows. */
+        if(event_array_resize(array, array->capacity + LV_ARRAY_DEFAULT_CAPACITY) == false) {
+            return LV_RESULT_INVALID;
+        }
+    }
+
+    uint8_t * data = array->data + array->size * array->element_size;
+    if(element) lv_memcpy(data, element, array->element_size);
+    else lv_memzero(data, array->element_size);
+
+    array->size++;
+    return LV_RESULT_OK;
+}
+
+static void event_array_deinit(lv_array_t * array)
+{
+    if(array->data) {
+        oxivgl_event_free(array->data);
+        array->data = NULL;
+    }
+
+    array->size = 0;
+    array->capacity = 0;
+}
+
 static void cleanup_event_list_core(lv_array_t * array)
 {
     const uint32_t size = lv_array_size(array);
